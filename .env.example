# ---- Gemini ----
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_PROVIDER=gemini
EMBEDDING_DIMS=768

# ---- Postgres ----
# Used by the backend app (psycopg connection string)
DATABASE_URL=postgresql://ragadmin:ragpassword@localhost:55432/agentic_rag
# Used by docker-compose to bootstrap the postgres container
POSTGRES_USER=ragadmin
POSTGRES_PASSWORD=ragpassword
POSTGRES_DB=agentic_rag

# ---- Mock enterprise APIs ----
WORKDAY_API_URL=http://localhost:8001
SERVICENOW_API_URL=http://localhost:8002

# ---- RAG feature flags (turn on/off to compare behavior) ----
ENABLE_QUERY_REWRITE=false
ENABLE_QUERY_EXPANSION=false
ENABLE_HYDE=false
ENABLE_HYBRID_SEARCH=true
ENABLE_RERANKING=true
ENABLE_PARENT_CHILD=true
ENABLE_METADATA_ROUTING=true
ENABLE_EMBEDDING_INTENT_CLASSIFIER=true

# ---- Retrieval tuning ----
VECTOR_TOP_K=20
KEYWORD_TOP_K=20
RRF_K=60
RERANK_TOP_N=5
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
CONTEXT_MAX_TOKENS=3000

# ---- Debug / learning mode ----
DEBUG_MODE=true

# ---- Optional LangSmith tracing (off by default) ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-rag-learning
